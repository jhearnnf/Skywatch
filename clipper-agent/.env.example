# Where the SkyWatch backend lives. Local by default — the agent and the API
# normally run on the same workstation.
CLIPPER_API_URL=http://localhost:5000

# Must match CLIPPER_AGENT_TOKEN in backend/.env.
CLIPPER_AGENT_TOKEN=

# Free-text label so several machines are distinguishable in the job log.
CLIPPER_AGENT_ID=workstation

# Seconds between polls when the queue is empty.
CLIPPER_POLL_SECONDS=5

# ── Capture target ─────────────────────────────────────────────────────────
# The site the recording browser drives, and the database behind it.
CLIPPER_CAPTURE_BASE_URL=http://localhost:5173
CLIPPER_CAPTURE_MONGO_URI=mongodb://127.0.0.1:27017/skywatch_clipper

# Capture refuses to run until this says "yes".
#
# A local URL is NOT proof of a disposable database — http://localhost:5173 is
# the ordinary dev server, and this project's local backend talks to the
# DEPLOYED database. The bot signs in and plays games, so running it against
# that would put fabricated scores on the real leaderboard.
#
# Before setting this: seed a throwaway database
# (node backend/scripts/seedClipperDemoData.js) and start a backend pointed at
# it, then point CLIPPER_CAPTURE_BASE_URL at the site using that backend.
CLIPPER_CAPTURE_DISPOSABLE=no

# Headless captures are faster but render WebGL in software, which turns the
# CBAT games into a slideshow. Leave this false so recordings use the GPU.
CLIPPER_CAPTURE_HEADLESS=false

# whisper.cpp model for caption timing. base.en is the right choice: the
# transcript's words are discarded and only its timings are used, so a larger
# model costs 1.5GB to improve the one thing we do not need.
WHISPER_MODEL=base.en

# ── Voicebox (added with the voice stage) ──────────────────────────────────
# The agent spawns voicebox-server.exe itself; the app does not need to be open.
# Point DATA_DIR at the real one so your existing voice profiles are visible.
VOICEBOX_EXE=C:\Users\James\AppData\Local\Voicebox\voicebox-server.exe
VOICEBOX_DATA_DIR=C:\Users\James\AppData\Roaming\sh.voicebox.app
VOICEBOX_PORT=34254

# ── Where finished Clipper renders are written ─────────────────────────────
# A render is a deliverable, not a temp file: it gets uploaded, kept and
# compared against the next one, and the OS sweeps temp folders. Leave unset to
# fall back to %TEMP%/skywatch-clipper/renders.
#
# Must be IDENTICAL on both sides (backend/.env and clipper-agent/.env). The
# backend uses it as the allowlist for "Show in folder"; set it on one side
# only and every reveal is refused as being outside the renders folder.
CLIPPER_RENDER_DIR=
