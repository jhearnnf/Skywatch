{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.skywatch.academy" }],
      "destination": "https://skywatch.academy/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/cbat-guide", "destination": "/cbat-guide.html" },
    { "source": "/cbat-guide-canada", "destination": "/cbat-guide-canada.html" },
    { "source": "/cbat-guide-australia", "destination": "/cbat-guide-australia.html" },
    { "source": "/((?!assets/|sounds/|images/|models/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
