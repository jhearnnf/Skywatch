<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for chat push notifications (backend/utils/pushNotify.js
     names it). Android draws this as a white silhouette, so it is the brand
     reticle from the app icon in flat white: outer ring, four ticks, inner
     ring and centre dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer ring, r = 8.6 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:pathData="M12,3.4a8.6,8.6 0,1 1,0 17.2a8.6,8.6 0,1 1,0 -17.2z" />
    <!-- Cardinal ticks -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M12,1.6V7.4M12,16.6V22.4M1.6,12H7.4M16.6,12H22.4" />
    <!-- Inner ring, r = 3.6 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:pathData="M12,8.4a3.6,3.6 0,1 1,0 7.2a3.6,3.6 0,1 1,0 -7.2z" />
    <!-- Centre dot, r = 1.3 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.7a1.3,1.3 0,1 1,0 2.6a1.3,1.3 0,1 1,0 -2.6z" />
</vector>
