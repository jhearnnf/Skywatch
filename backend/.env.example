PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skywatch?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
# Session length in days. Sessions slide forward on use (see utils/authToken.js),
# so an active user is never logged out — this is the idle window, not a hard cap.
JWT_TTL_DAYS=90
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
# Key for the erasure register's one-way email hash (see models/AccountDeletion.js).
# It is what stops that register being reversible into a list of former users, so
# treat it as a secret. Falls back to JWT_SECRET if unset. Rotating it does not
# break anything, but "was this address deleted?" lookups stop matching rows
# written under the previous key — so set it once and leave it.
#   openssl rand -base64 32
ACCOUNT_DELETION_PEPPER=
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# OpenRouter — used server-side for AI features (never exposed to the browser)
OPENROUTER_KEY=your_openrouter_api_key_here
# Optional: separate key for APTITUDE_SYNC game; falls back to OPENROUTER_KEY if not set
OPENROUTER_KEY_APTITUDE=your_openrouter_aptitude_key_here
# Optional: separate key used exclusively by the admin Socials draft feature
# (X/Twitter post drafting). Falls back to OPENROUTER_KEY if not set.
OPENROUTER_KEY_SOCIALS=your_openrouter_socials_key_here
# Optional: separate key used exclusively by the Case Files game's
# interrogation AI calls. Falls back to OPENROUTER_KEY if not set.
OPENROUTER_KEY_CASEFILES=your_openrouter_casefiles_key_here
# Optional: separate key used exclusively by the Brief Reel feature
# (AI-generated stickman animations for brief description sections).
# Falls back to OPENROUTER_KEY if not set.
OPENROUTER_KEY_BRIEFREEL=your_openrouter_briefreel_key_here
# Optional: separate key used exclusively by the admin Clipper feature
# (short-form video idea + script generation). Falls back to OPENROUTER_KEY.
OPENROUTER_KEY_CLIPPER=your_openrouter_clipper_key_here

# Shared secret the local Clipper agent presents when claiming video jobs.
# The agent runs on a workstation, not in a browser, so it cannot authenticate
# with a session cookie — this is how the server knows a job request is really
# yours. Generate with:  openssl rand -base64 32
# Leave blank to disable the agent endpoints entirely.
CLIPPER_AGENT_TOKEN=

# Resend — transactional email (https://resend.com)
# Used to send welcome emails on registration
RESEND_API_KEY=your_resend_api_key_here

# DVIDS — US DoD official photo library (https://api.dvidshub.net/register)
# Used as the first source in the image waterfall. Leave blank to skip DVIDS.
DVIDS_API_KEY=

# Stock video providers for Clipper stage 2 (footage search).
# Both are free to register and both are optional — an unset key just means that
# provider is skipped. DVIDS (above) is the best fit for military b-roll and is
# already configured; these cover generic/atmospheric filler it will not have.
#   Pexels:  https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ElevenLabs — optional cloud TTS for Clipper stage 3. Voicebox on the
# workstation is the default and costs nothing; this is for when a local voice
# does not suit a particular video. Leave blank and the ElevenLabs option is
# greyed out in the UI rather than failing at generation time.
#   https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Cloudinary — cloud image storage for brief images (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe — subscription payments (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SILVER_PRICE_ID=price_...
STRIPE_GOLD_PRICE_ID=price_...

# Cloudflare Turnstile — bot-prevention CAPTCHA for signup (https://dash.cloudflare.com/?to=/:account/turnstile)
# Leave blank to disable server-side verification (the admin UI will show a warning if the flag is on).
TURNSTILE_SECRET_KEY=

# X (Twitter) API — OAuth 2.0 PKCE for posting from the admin Socials panel
# Create app at https://developer.x.com — set the callback URL to X_REDIRECT_URI below.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5000/api/admin/social/x/callback

# AES-256-GCM key for encrypting OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
SOCIAL_TOKEN_KEY=

# Discord — webhook that receives CBAT medal broadcasts (new 1st/2nd/3rd places).
# Create it in Discord: channel → Edit Channel → Integrations → Webhooks → New Webhook,
# then copy the webhook URL here. Treat it as a secret: anyone holding it can post
# to that channel. Leave blank to disable broadcasts entirely — the admin toggle
# (Content → Discord) has no effect without it.
DISCORD_WEBHOOK_URL=

# GitHub API — used for "brand transparency" social posts that surface recent
# significant commits. Use a fine-grained PAT scoped only to this repo with
# Contents:read permission. Leave both blank to disable brand-transparency posts.
GITHUB_REPO=jhearnnf/Skywatch
GITHUB_TOKEN=
